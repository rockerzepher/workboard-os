# Public Google OAuth 2.0 Web client ID for the local Workboard app.
# Configure the OAuth consent screen, enable Google Tasks API, and add
# http://127.0.0.1:5173 as an authorized JavaScript origin.
VITE_GOOGLE_CLIENT_ID=

# Notion OAuth values are server-only. Never prefix the secret with VITE_.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://127.0.0.1:5173/api/notion/callback
